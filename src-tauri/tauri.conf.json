{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Märklig",
  "version": "0.1.0",
  "identifier": "se.karleklund.marklig",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Märklig",
        "width": 1000,
        "height": 760,
        "minWidth": 480,
        "minHeight": 320,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdx", "mdown"],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "text/markdown",
        "contentTypes": ["net.daringfireball.markdown", "public.plain-text"],
        "exportedType": {
          "identifier": "net.daringfireball.markdown",
          "conformsTo": ["public.plain-text"]
        }
      }
    ]
  }
}
